  "cards": [
    {
      "dot": "emerald",
      "title": "Enrol a folder (once)",
      "items": [
        "UI uploads each reference photo; the file name is the person's name",
        "Unchanged photos are answered from a cache keyed by file hash",
        "Largest face is aligned, embedded with its mirror image, and stored in SQLite",
        "Finalize builds the FAISS index from SQLite"
      ]
    },
    {
      "dot": "cyan",
      "title": "Identify a group photo",
      "items": [
        "Detector runs at up to 1280 px plus a 640 px pass",
        "Each face is aligned and embedded",
        "Matcher names a face only at similarity 0.35 or more, one name per person",
        "Everyone else is Unknown, with the closest name as a hint"
      ]
    },
    {
      "dot": "rose",
      "title": "Security gateway",
      "items": [
        "Host allow-list and origin checks, no CORS",
        "HttpOnly SameSite=Strict session cookie, new on every launch",
        "CSRF token header on every change",
        "Upload size and type limits, rate limits, security headers"
      ]
    },
    {
      "dot": "slate",
      "title": "Offline by design",
      "items": [
        "No network calls at runtime; models are files on disk",
        "CPU only through ONNX Runtime",
        "The server listens on the loopback address only"
      ]
    }
  ]
